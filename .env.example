# Evrakyol ortam değişkenleri
# Bu dosyayı kök klasörde `.env` adıyla kopyalayın. Web, API ve Docker Compose aynı dosyayı okur.
# Gerçek anahtarları asla commit etmeyin.

# --- Veritabanı ---
# Yerel geliştirmede Docker Compose içindeki Postgres (pgvector) kullanılır.
DATABASE_URL=postgresql://evrakyol:evrakyol@localhost:5432/evrakyol

# --- Redis (hız sınırlama) ---
REDIS_URL=redis://localhost:6379/0

# --- Servisler arası iletişim ---
# Web uygulamasının yapay zekâ servisine eriştiği adres
API_BASE_URL=http://127.0.0.1:8000
# Web -> API çağrılarında kullanılan paylaşılan gizli anahtar (uzun, rastgele bir değer üretin)
INTERNAL_API_TOKEN=

# --- LLM (sağlayıcıdan bağımsız katman) ---
LLM_PROVIDER=anthropic
# Varsayılan: en yetenekli Opus. Daha düşük maliyet için: claude-sonnet-5-5
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (yüksek değerler daha dikkatli ama daha pahalı)
LLM_EFFORT=high
LLM_UNDERSTANDING_EFFORT=low
# Güvenlik sınıflandırıcısı isteği reddederse sunucu tarafında yedek modelle yeniden dene
LLM_FALLBACKS=true
ANTHROPIC_API_KEY=
# Günlük LLM çağrı tavanı (maliyet koruması). Bir yol haritası 2-4 çağrı kullanır.
# Ayrıca console.anthropic.com üzerinden aylık harcama sınırı tanımlanması önerilir.
LLM_DAILY_REQUEST_LIMIT=100

# --- Embedding (kendi sunucumuzda çalışır) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# bge: gerçek model (ilk kullanımda ~2 GB indirilir) | fake: modelsiz hızlı deneme (anlamsız vektörler)
EMBEDDING_BACKEND=bge
# db: yayındaki hibrit arama (Postgres) | memory: veritabanı olmadan yerel deneme (kaynaklar canlı çekilir)
RETRIEVER_BACKEND=db

# --- Kimlik doğrulama (Auth.js) ---
# `npx auth secret` ile üretilebilir
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-posta ile giriş bağlantısı göndermek için
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# --- Genel ---
LOG_LEVEL=info
